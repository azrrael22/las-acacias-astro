---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import FloatingCartButton from '../../components/FloatingCartButton.astro';
import CartModal from '../../components/CartModal.astro';
import WhatsAppModal from '../../components/WhatsAppModal.astro';
import Icon from '../../components/Icon.astro';
import { products } from '../../data/products';
import { getLangFromUrl, langStaticPaths } from '../../i18n';
import { cafeOrigen } from '../../i18n/cafe-origen';
import { ui } from '../../i18n/ui';

// Se genera en /cafe-origen (español) y en /en/cafe-origen (inglés). Textos en src/i18n/cafe-origen.ts
export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = cafeOrigen[lang];
const u = ui[lang];
---

<BaseLayout title={t.title} description={t.description}>

  <!-- ORGANISMO: Hero de la Tienda -->
  <section class="hero hero--tienda" id="tienda">
    <div class="hero-texto">
      <p class="rotulo">{t.hero.rotulo}</p>
      <h1 class="hero-titular">
        {t.hero.titular.map(linea => <span set:html={linea} />)}
      </h1>
      <p class="hero-descripcion">{t.hero.descripcion}</p>
      <div class="badge-group">
        <span class="badge-item">
          <span class="badge-dot badge-dot-verde" aria-hidden="true"></span>
          {u.tienda.badgeManual}
        </span>
        <span class="badge-item">
          <span class="badge-dot badge-dot-header" aria-hidden="true"></span>
          {u.tienda.badgeEnvios}
        </span>
      </div>
      <p class="hero-nota">
        <Icon name="truck" size={16} />
        {t.hero.nota}
      </p>
    </div>
    <div class="hero-imagen">
      <img src="/Imagenes/Productos/presentaciones.webp"
           width="1200" height="896"
           fetchpriority="high"
           decoding="async"
           alt={u.tienda.presentacionesAlt} />
    </div>
  </section>

  <!-- ORGANISMO: Grid de Productos -->
  <section class="productos-seccion section-inner" aria-labelledby="productos-titulo">
    <div class="encabezado-seccion" data-revelar>
      <p class="rotulo"><span class="rotulo-num">01</span>{t.productos.rotulo}</p>
      <h2 class="titulo-seccion" id="productos-titulo" set:html={t.productos.titulo} />
    </div>
    <div class="productos-grid" data-revelar>
      {products.map(product => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>

  <!-- Componentes del carrito -->
  <FloatingCartButton />
  <CartModal />
  <WhatsAppModal />

</BaseLayout>
