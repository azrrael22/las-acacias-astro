---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { buildWhatsAppURL } from '../../data/contacto';
import { getLangFromUrl, langStaticPaths, localizePath } from '../../i18n';
import { inicio } from '../../i18n/inicio';
import { ui } from '../../i18n/ui';

// Se genera en / (español) y en /en/ (inglés). Textos en src/i18n/inicio.ts
export function getStaticPaths() {
  return langStaticPaths();
}

const lang = getLangFromUrl(Astro.url);
const t = inicio[lang];
const u = ui[lang];

// El tour no se reserva: WhatsApp es para pedir información o resolver dudas
const infoURL = buildWhatsAppURL(t.mensajes.info);
const preguntaTourURL = buildWhatsAppURL(t.mensajes.preguntaTour);
const tiendaURL = localizePath('/cafe-origen', lang);
const mapaURL = `https://maps.google.com/maps?saddr=Plaza+de+Salento,+Quind%C3%ADo,+Colombia&daddr=Las+Acacias+Coffee+Farm,+Palestina,+Salento,+Quind%C3%ADo&hl=${lang}&output=embed`;
---
<BaseLayout title={t.title}>

  <!-- ORGANISMO: Hero -->
  <section class="hero" id="home">
    <div class="hero-texto">
      <p class="rotulo">{t.hero.rotulo}</p>
      <h1 class="hero-titular">
        {t.hero.titular.map(linea => <span set:html={linea} />)}
      </h1>
      <p class="hero-descripcion">{t.hero.descripcion}</p>
      <div class="acciones">
        <a href={infoURL}
           class="btn btn-primario btn-lg"
           target="_blank" rel="noopener noreferrer"
           aria-label={t.hero.whatsappAria}>
          <Icon name="message-circle" />
          {t.hero.whatsapp}
        </a>
        <a href={tiendaURL} class="enlace-flecha">
          {t.hero.tienda}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <div class="hero-imagen">
      <img src="/Imagenes/Carrucel1/1.webp"
           width="1080" height="1440"
           fetchpriority="high"
           decoding="async"
           alt={t.hero.imagenAlt} />
    </div>
  </section>

  <!-- ORGANISMO: Datos de la finca -->
  <section class="datos-seccion section-inner" aria-label={t.datosAria}>
    <ul class="datos-finca">
      {t.datos.map(dato => (
        <li class="dato">
          <span class="dato-cifra">{dato.cifra}</span>
          <span class="dato-etiqueta">{dato.etiqueta}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ORGANISMO: Proceso (01 La experiencia) -->
  <section class="proceso section-inner" id="experiencia" aria-labelledby="experiencia-titulo">
    <div class="encabezado-seccion" data-revelar>
      <p class="rotulo"><span class="rotulo-num">01</span>{t.experiencia.rotulo}</p>
      <h2 class="titulo-seccion" id="experiencia-titulo" set:html={t.experiencia.titulo} />
      <p class="entrada">{t.experiencia.entrada}</p>
    </div>
    <div class="proceso-grid">
      {t.pasos.map((paso, i) => (
        <figure class="paso" data-revelar style={`--i: ${i}`}>
          <img class="paso-foto" src={paso.src} alt={paso.alt}
               width="1080" height="1440" loading="lazy" decoding="async" />
          <figcaption class="paso-pie">
            <span class="paso-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="paso-titulo">{paso.titulo}</h3>
            <p class="paso-texto">{paso.texto}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ORGANISMO: Coffee Tour (02) -->
  <section class="coffee-tour" id="tour" aria-labelledby="tour-titulo">
    <div class="coffee-tour-imagen">
      <img src="/Imagenes/Carrucel1/2.webp"
           width="1080" height="1440"
           loading="lazy" decoding="async"
           alt={t.tour.imagenAlt} />
    </div>
    <div class="coffee-tour-texto" data-revelar>
      <div class="encabezado-seccion">
        <p class="rotulo"><span class="rotulo-num">02</span>{t.tour.rotulo}</p>
        <h2 class="titulo-seccion" id="tour-titulo" set:html={t.tour.titulo} />
        <p class="entrada">{t.tour.entrada}</p>
      </div>
      <ul class="lista-iconos">
        <li><Icon name="clock" size={20} />{t.tour.horario}</li>
        <li><Icon name="check" size={20} />{t.tour.sinReserva}</li>
        <li><Icon name="languages" size={20} />{t.tour.idiomas}</li>
        <li><Icon name="map-pin" size={20} /><span>{t.tour.distancia} · <a href="#como-llegar">{t.tour.comoLlegar}</a></span></li>
      </ul>
      <div class="acciones">
        <a href={preguntaTourURL}
           class="btn btn-primario btn-lg"
           target="_blank" rel="noopener noreferrer"
           aria-label={t.tour.whatsappAria}>
          <Icon name="message-circle" />
          {t.tour.whatsapp}
        </a>
      </div>
    </div>
  </section>

  <!-- ORGANISMO: Adelanto de la tienda (03) -->
  <section class="adelanto-tienda" aria-labelledby="tienda-titulo">
    <div class="adelanto-tienda-grid section-inner" data-revelar>
      <div class="adelanto-tienda-imagen">
        <img src="/Imagenes/Productos/presentaciones.webp"
             width="1200" height="896"
             loading="lazy" decoding="async"
             alt={u.tienda.presentacionesAlt} />
      </div>
      <div class="adelanto-tienda-texto">
        <div class="encabezado-seccion">
          <p class="rotulo"><span class="rotulo-num">03</span>{t.tienda.rotulo}</p>
          <h2 class="titulo-seccion" id="tienda-titulo" set:html={t.tienda.titulo} />
          <p class="entrada">{t.tienda.entrada}</p>
        </div>
        <div class="badge-group">
          <span class="badge-item">
            <span class="badge-dot badge-dot-verde" aria-hidden="true"></span>
            {u.tienda.badgeManual}
          </span>
          <span class="badge-item">
            <span class="badge-dot badge-dot-header" aria-hidden="true"></span>
            {u.tienda.badgeEnvios}
          </span>
        </div>
        <div class="acciones">
          <a href={tiendaURL} class="btn btn-primario btn-lg">
            {t.tienda.cta}
            <Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ORGANISMO: Cómo llegar (04) -->
  <section class="como-llegar section-inner" id="como-llegar" aria-labelledby="como-llegar-titulo">
    <div class="encabezado-seccion" data-revelar>
      <p class="rotulo"><span class="rotulo-num">04</span>{t.comoLlegar.rotulo}</p>
      <h2 class="titulo-seccion" id="como-llegar-titulo" set:html={t.comoLlegar.titulo} />
      <p class="entrada">{t.comoLlegar.entrada}</p>
    </div>
    <div class="como-llegar-mapa" data-revelar>
      <iframe
        src={mapaURL}
        title={t.comoLlegar.mapaTitulo}
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade">
      </iframe>
    </div>
    <div class="como-llegar-grid">
      {t.transportes.map((transporte, i) => (
        <article class="transport-item" data-revelar style={`--i: ${i % 2}`}>
          <img class="transport-icon" src={transporte.icono} width="48" height="48" loading="lazy" alt="" />
          <h3 class="transport-titulo">{transporte.titulo}</h3>
          <p class="transport-desc">{transporte.texto}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- ORGANISMO: Cierre -->
  <div class="cierre section-inner">
    <div class="ornamento" aria-hidden="true"><Icon name="sprout" size={24} /></div>
  </div>

</BaseLayout>
