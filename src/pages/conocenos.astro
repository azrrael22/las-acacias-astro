---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Conócenos · Las Acacias Coffee Farm · Salento" description="Conoce la historia de Finca Las Acacias: una familia cafetera en Salento, Quindío, dedicada al cultivo artesanal y los tours de café de origen.">

  <h1 class="visually-hidden">Conócenos</h1>

  <!-- ORGANISMO: Misión -->
  <section class="mision section-inner">
    <div class="mv-texto">
      <h2 class="mv-titulo">Misión</h2>
      <p class="mv-descripcion">
        Una finca cafetera familiar en la cordillera central colombiana.
        Recorre el cultivo, el beneficio y el tueste con nosotros,
        y llévate a casa un café cosechado y procesado a mano.
      </p>
      <div class="badge-group">
        <span class="badge-item">
          <img src="https://www.figma.com/api/mcp/asset/cd80ba5d-4aeb-47c2-b136-fb737b1f8e62" alt="Ícono: Proceso 100% manual" />
          Proceso 100% manual
        </span>
        <span class="badge-item">
          <img src="https://www.figma.com/api/mcp/asset/4750d9f6-7944-4a95-a528-a8c272ed9e68" alt="Ícono: Finca familiar" />
          Finca familiar
        </span>
      </div>
    </div>
    <div class="mv-imagen">
      <img class="img-circular"
           src="/Imagenes/logo.png"
           onerror="this.src='https://www.figma.com/api/mcp/asset/d9a81a27-53bf-446b-90db-b6edaa48547b'"
           alt="Logo Las Acacias Coffee Farm" />
    </div>
  </section>

  <!-- ORGANISMO: Visión -->
  <section class="vision section-inner">
    <div class="mv-imagen">
      <img class="img-circular"
           src="/Imagenes/logo.png"
           onerror="this.src='https://www.figma.com/api/mcp/asset/d9a81a27-53bf-446b-90db-b6edaa48547b'"
           alt="Logo Las Acacias Coffee Farm" />
    </div>
    <div class="mv-texto">
      <h2 class="mv-titulo">Visión</h2>
      <p class="mv-descripcion">
        Una finca cafetera familiar en la cordillera central colombiana.
        Recorre el cultivo, el beneficio y el tueste con nosotros,
        y llévate a casa un café cosechado y procesado a mano.
      </p>
      <div class="badge-group">
        <span class="badge-item">
          <img src="https://www.figma.com/api/mcp/asset/cd80ba5d-4aeb-47c2-b136-fb737b1f8e62" alt="Ícono: Proceso 100% manual" />
          Proceso 100% manual
        </span>
        <span class="badge-item">
          <img src="https://www.figma.com/api/mcp/asset/4750d9f6-7944-4a95-a528-a8c272ed9e68" alt="Ícono: Finca familiar" />
          Finca familiar
        </span>
      </div>
    </div>
  </section>

</BaseLayout>
