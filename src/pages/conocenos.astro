---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Conócenos · Las Acacias Coffee Farm · Salento" description="Conoce la historia de Finca Las Acacias: una familia cafetera en Salento, Quindío, dedicada al cultivo artesanal y los tours de café de origen.">

  <h1 class="visually-hidden">Conócenos</h1>

  <!-- ORGANISMO: Misión -->
  <section class="mision section-inner" aria-labelledby="mision-titulo">
    <div class="mv-texto encabezado-seccion">
      <p class="rotulo"><span class="rotulo-num">01</span>Lo que hacemos</p>
      <h2 class="titulo-seccion" id="mision-titulo">Misión</h2>
      <p class="entrada">
        Una finca cafetera familiar en la cordillera central colombiana.
        Recorre el cultivo, el beneficio y el tueste con nosotros,
        y llévate a casa un café cosechado y procesado a mano.
      </p>
      <div class="badge-group">
        <span class="badge-item">
          <span class="badge-dot badge-dot-verde" aria-hidden="true"></span>
          Proceso 100% manual
        </span>
        <span class="badge-item">
          <span class="badge-dot badge-dot-header" aria-hidden="true"></span>
          Finca familiar
        </span>
      </div>
    </div>
    <div class="mv-imagen">
      <img class="img-circular"
           src="/Imagenes/logo.png"
           onerror="this.src='https://www.figma.com/api/mcp/asset/d9a81a27-53bf-446b-90db-b6edaa48547b'"
           width="360" height="360"
           alt="Logo Las Acacias Coffee Farm" />
    </div>
  </section>

  <!-- ORGANISMO: Visión -->
  <section class="vision section-inner" aria-labelledby="vision-titulo" data-revelar>
    <div class="mv-imagen">
      <img class="img-circular"
           src="/Imagenes/logo.png"
           onerror="this.src='https://www.figma.com/api/mcp/asset/d9a81a27-53bf-446b-90db-b6edaa48547b'"
           width="360" height="360"
           loading="lazy"
           alt="Logo Las Acacias Coffee Farm" />
    </div>
    <div class="mv-texto encabezado-seccion">
      <p class="rotulo"><span class="rotulo-num">02</span>Hacia dónde vamos</p>
      <h2 class="titulo-seccion" id="vision-titulo">Visión</h2>
      <p class="entrada">
        Una finca cafetera familiar en la cordillera central colombiana.
        Recorre el cultivo, el beneficio y el tueste con nosotros,
        y llévate a casa un café cosechado y procesado a mano.
      </p>
      <div class="badge-group">
        <span class="badge-item">
          <span class="badge-dot badge-dot-verde" aria-hidden="true"></span>
          Proceso 100% manual
        </span>
        <span class="badge-item">
          <span class="badge-dot badge-dot-header" aria-hidden="true"></span>
          Finca familiar
        </span>
      </div>
    </div>
  </section>

</BaseLayout>
