---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Finca cafetera familiar en Salento, Quindío. Vive el café desde la semilla hasta la taza con nuestros tours, cultivo artesanal y café de origen 100% manual.',
} = Astro.props;

const ogImage = '/Imagenes/logo.png';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..500&family=Great+Vibes&display=swap" rel="stylesheet" />
  <!-- Revelado al hacer scroll: se activa antes del primer pintado para que no parpadee -->
  <script is:inline>
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('revelar-js');
    }
  </script>
</head>
<body>
  <Header />
  <main class="contenido">
    <slot />
  </main>
  <Footer />

  <script>
    // Muestra cada [data-revelar] la primera vez que entra en pantalla
    if (document.documentElement.classList.contains('revelar-js')) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('revelado');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('[data-revelar]').forEach((el) => observer.observe(el));
    }
  </script>
</body>
</html>
