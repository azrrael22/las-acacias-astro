---
// Modal del carrito de compras (estilos en organisms.css)
import Icon from './Icon.astro';
import { getLangFromUrl } from '../i18n';
import { ui } from '../i18n/ui';

const u = ui[getLangFromUrl(Astro.url)].carrito;
---

<div id="cart-modal" class="cart-modal" role="dialog" aria-modal="true" aria-labelledby="cart-modal-title" aria-hidden="true">
  <div class="cart-overlay"></div>
  <div class="cart-panel">
    <div class="cart-header">
      <h2 id="cart-modal-title" class="cart-title">{u.titulo}</h2>
      <button id="cart-close-btn" class="btn-icono cart-close-btn" type="button" aria-label={u.cerrar}>
        <Icon name="x" />
      </button>
    </div>

    <div class="cart-body">
      <!-- Nombre del cliente -->
      <div class="cart-customer-section">
        <label for="customer-name" class="customer-label">{u.nombre}</label>
        <input
          type="text"
          id="customer-name"
          class="customer-input"
          placeholder={u.nombrePlaceholder}
          autocomplete="name"
          aria-describedby="customer-name-error"
        />
        <p id="customer-name-error" class="error-message" role="alert"></p>
      </div>

      <!-- Lista de productos (se renderiza en el cliente) -->
      <div id="cart-items-container" class="cart-items"></div>

      <!-- Carrito vacío -->
      <div id="empty-cart-message" class="empty-cart-message">
        <Icon name="shopping-bag" size={24} />
        <p class="empty-cart-titulo">{u.vacioTitulo}</p>
        <p class="empty-cart-subtitle">{u.vacioSubtitulo}</p>
      </div>
    </div>

    <div class="cart-footer">
      <div class="cart-total">
        <span class="total-label">{u.total}</span>
        <span id="cart-total-amount" class="total-amount">$0</span>
      </div>
      <button id="checkout-btn" class="btn btn-primario btn-lg checkout-btn" type="button">
        <Icon name="send" />
        {u.enviar}
      </button>
      <p id="checkout-error" class="error-message" role="alert"></p>
    </div>
  </div>
</div>

<script>
  import { 
    getCart, 
    getCartTotal, 
    updateCartItemQuantity, 
    removeFromCart, 
    setCustomerName,
    getCustomerName,
    CART_UPDATED_EVENT,
    formatPrice 
  } from '../scripts/cart';
  import { iconSvg } from '../scripts/icons';
  import { getDocumentLang } from '../i18n';
  import { ui } from '../i18n/ui';

  const lang = getDocumentLang();
  const t = ui[lang];

  // ============================================
  // ELEMENTOS DEL DOM
  // ============================================

  const modal = document.getElementById('cart-modal');
  const overlay = modal?.querySelector('.cart-overlay');
  const closeBtn = document.getElementById('cart-close-btn');
  const itemsContainer = document.getElementById('cart-items-container');
  const emptyMessage = document.getElementById('empty-cart-message');
  const totalAmountEl = document.getElementById('cart-total-amount');
  const customerNameInput = document.getElementById('customer-name') as HTMLInputElement;
  const customerNameError = document.getElementById('customer-name-error');
  const checkoutBtn = document.getElementById('checkout-btn');
  const checkoutError = document.getElementById('checkout-error');

  // ============================================
  // FUNCIONES DE UI
  // ============================================

  function openModal() {
    if (modal) {
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      renderCart();
      
      // Cargar nombre guardado
      if (customerNameInput) {
        customerNameInput.value = getCustomerName();
      }
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      
      // Limpiar errores
      clearErrors();
    }
  }

  function clearErrors() {
    if (customerNameError) customerNameError.textContent = '';
    if (checkoutError) checkoutError.textContent = '';
    customerNameInput?.classList.remove('error');
    customerNameInput?.removeAttribute('aria-invalid');
  }

  function renderCart() {
    const cart = getCart();
    
    if (!itemsContainer || !emptyMessage || !totalAmountEl) return;

    // Mostrar/ocultar mensaje de carrito vacío
    const isEmpty = cart.items.length === 0;
    itemsContainer.style.display = isEmpty ? 'none' : '';
    emptyMessage.style.display = isEmpty ? '' : 'none';

    // Renderizar items
    itemsContainer.innerHTML = cart.items.map(item => {
      if (!item.product) return '';

      const { tipo, precio } = item.product;
      const nombre = item.product.nombre[lang];
      const tipoLabel = t.producto.tipo[tipo];
      const etiqueta = `${nombre} ${tipoLabel.toLowerCase()}`;
      const subtotal = precio * item.quantity;

      return `
        <div class="cart-item" data-product-id="${item.productId}">
          <div class="cart-item-info">
            <h3 class="cart-item-name">${nombre}</h3>
            <p class="cart-item-meta">${tipoLabel} · ${formatPrice(precio, lang)} ${t.carrito.cadaUno}</p>
          </div>
          <p class="cart-item-subtotal">${formatPrice(subtotal, lang)}</p>
          <div class="cart-item-controls">
            <div class="quantity-controls">
              <button class="qty-btn qty-decrease" type="button" data-product-id="${item.productId}" aria-label="${t.carrito.quitarUno(etiqueta)}">${iconSvg('minus', 16)}</button>
              <span class="qty-display" aria-label="${t.carrito.cantidad}">${item.quantity}</span>
              <button class="qty-btn qty-increase" type="button" data-product-id="${item.productId}" aria-label="${t.carrito.agregarUno(etiqueta)}">${iconSvg('plus', 16)}</button>
            </div>
          </div>
          <button class="btn-icono btn-icono-sm cart-item-remove" type="button" data-product-id="${item.productId}" aria-label="${t.carrito.eliminar(etiqueta)}">${iconSvg('trash-2', 16)}</button>
        </div>
      `;
    }).join('');

    // Actualizar total
    totalAmountEl.textContent = formatPrice(getCartTotal(), lang);

    // Agregar event listeners a los controles
    addCartItemListeners();
  }

  function addCartItemListeners() {
    // Botones de cantidad
    document.querySelectorAll('.qty-decrease').forEach(btn => {
      btn.addEventListener('click', function(this: HTMLButtonElement) {
        const productId = this.dataset.productId;
        if (!productId) return;
        
        const cart = getCart();
        const item = cart.items.find(i => i.productId === productId);
        if (item) {
          updateCartItemQuantity(productId, item.quantity - 1);
        }
      });
    });

    document.querySelectorAll('.qty-increase').forEach(btn => {
      btn.addEventListener('click', function(this: HTMLButtonElement) {
        const productId = this.dataset.productId;
        if (!productId) return;
        
        const cart = getCart();
        const item = cart.items.find(i => i.productId === productId);
        if (item) {
          updateCartItemQuantity(productId, item.quantity + 1);
        }
      });
    });

    // Botones de eliminar
    document.querySelectorAll('.cart-item-remove').forEach(btn => {
      btn.addEventListener('click', function(this: HTMLButtonElement) {
        const productId = this.dataset.productId;
        if (productId) {
          removeFromCart(productId);
        }
      });
    });
  }

  // ============================================
  // EVENT LISTENERS
  // ============================================

  // Abrir modal
  window.addEventListener('cart:open', openModal);

  // Cerrar modal
  closeBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', closeModal);

  // Cerrar con ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }
  });

  // Actualizar carrito cuando cambia
  window.addEventListener(CART_UPDATED_EVENT, () => {
    if (modal?.classList.contains('open')) {
      renderCart();
    }
  });

  // Guardar nombre del cliente
  customerNameInput?.addEventListener('input', function(this: HTMLInputElement) {
    setCustomerName(this.value);
    // Limpiar error al escribir
    if (customerNameError) customerNameError.textContent = '';
    this.classList.remove('error');
    this.removeAttribute('aria-invalid');
  });

  // Botón de checkout
  checkoutBtn?.addEventListener('click', () => {
    const cart = getCart();
    const customerName = customerNameInput?.value.trim() || '';

    // Limpiar errores previos
    clearErrors();

    // Validaciones
    let hasError = false;

    if (!customerName) {
      if (customerNameError) {
        customerNameError.textContent = t.carrito.errorNombre;
      }
      customerNameInput?.classList.add('error');
      customerNameInput?.setAttribute('aria-invalid', 'true');
      hasError = true;
    }

    if (cart.items.length === 0) {
      if (checkoutError) {
        checkoutError.textContent = t.carrito.errorVacio;
      }
      hasError = true;
    }

    if (hasError) return;

    // Guardar nombre y disparar evento para abrir modal de WhatsApp
    setCustomerName(customerName);
    window.dispatchEvent(new CustomEvent('cart:checkout', { 
      detail: { customerName } 
    }));
  });
</script>
