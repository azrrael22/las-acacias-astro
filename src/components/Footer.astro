---
import Icon from './Icon.astro';
import { getLangFromUrl } from '../i18n';
import { ui } from '../i18n/ui';

const u = ui[getLangFromUrl(Astro.url)].footer;
---
<footer class="site-footer">
  <div class="footer-grid section-inner">

    <div class="footer-brand">
      <img class="footer-logo img-circular"
           src="/Imagenes/logo.png"
           onerror="this.src='https://www.figma.com/api/mcp/asset/3b1748ad-dfef-420b-8d35-e7b989d2a85a'"
           width="72" height="72"
           loading="lazy"
           alt={u.logoAlt} />
      <address class="footer-address">
        Finca Las Acacias · Vereda Palestina<br />
        Salento · Quindío · Colombia
      </address>
    </div>

    <div class="footer-col-info">
      <h2 class="footer-col-titulo">{u.visitanos}</h2>
      <ul class="footer-list">
        <li>{u.horario}</li>
        <li>{u.idiomasTour}</li>
      </ul>
    </div>

    <div class="footer-col-info">
      <h2 class="footer-col-titulo">{u.contacto}</h2>
      <ul class="footer-list">
        <li>
          <a href="https://instagram.com/las_acacias_coffee_farm" class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.instagramAria}>
            <Icon name="instagram" />
            <span>@las_acacias_coffee_farm</span>
          </a>
        </li>
        <li>
          <a href="https://facebook.com/LasAcaciasCoffee" class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.facebookAria}>
            <Icon name="facebook" />
            <span>Las Acacias Coffee</span>
          </a>
        </li>
        <li>
          <a href="https://wa.me/573175336091" class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.whatsappAria('+57 317 533 6091')}>
            <Icon name="phone" />
            <span class="footer-telefono">+57 317 533 6091</span>
          </a>
        </li>
        <li>
          <a href="https://wa.me/573104638585" class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.whatsappAria('+57 310 463 8585')}>
            <Icon name="phone" />
            <span class="footer-telefono">+57 310 463 8585</span>
          </a>
        </li>
      </ul>
    </div>

  </div>

  <div class="footer-bottom section-inner">
    <span class="footer-copyright">© 2026 Las Acacias Coffee Farm · {u.derechos} · {u.creado}</span>
    <span class="footer-firma">{u.firma}</span>
  </div>
</footer>
