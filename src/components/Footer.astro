---
import Icon from './Icon.astro';
import { NEGOCIO, formatTelefono, whatsAppChatURL } from '../data/contacto';
import { getLangFromUrl } from '../i18n';
import { ui } from '../i18n/ui';

const u = ui[getLangFromUrl(Astro.url)].footer;
const { direccion: d } = NEGOCIO;
---
<footer class="site-footer">
  <div class="footer-grid section-inner">

    <div class="footer-brand">
      <img class="footer-logo img-circular"
           src="/Imagenes/logo-144.webp"
           onerror="this.src='https://www.figma.com/api/mcp/asset/3b1748ad-dfef-420b-8d35-e7b989d2a85a'"
           width="72" height="72"
           loading="lazy"
           alt={u.logoAlt} />
      <address class="footer-address">
        {d.finca} · {d.vereda}<br />
        {d.municipio} · {d.departamento} · {d.pais}
      </address>
    </div>

    <div class="footer-col-info">
      <h2 class="footer-col-titulo">{u.visitanos}</h2>
      <ul class="footer-list">
        <li>{u.horario}</li>
        <li>{u.idiomasTour}</li>
      </ul>
    </div>

    <div class="footer-col-info">
      <h2 class="footer-col-titulo">{u.contacto}</h2>
      <ul class="footer-list">
        <li>
          <a href={NEGOCIO.instagram.url} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.instagramAria}>
            <Icon name="instagram" />
            <span>{NEGOCIO.instagram.usuario}</span>
          </a>
        </li>
        <li>
          <a href={NEGOCIO.facebook.url} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.facebookAria}>
            <Icon name="facebook" />
            <span>{NEGOCIO.facebook.nombre}</span>
          </a>
        </li>
        {NEGOCIO.telefonos.map(numero => (
          <li>
            <a href={whatsAppChatURL(numero)} class="social-link" target="_blank" rel="noopener noreferrer" aria-label={u.whatsappAria(formatTelefono(numero))}>
              <Icon name="phone" />
              <span class="footer-telefono">{formatTelefono(numero)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

  </div>

  <div class="footer-bottom section-inner">
    <span class="footer-copyright">© 2026 {NEGOCIO.nombre} · {u.derechos} · {u.creado}</span>
    <span class="footer-firma">{u.firma}</span>
  </div>
</footer>
