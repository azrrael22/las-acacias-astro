---
// Ícono de línea en SVG (Lucide). Ver src/scripts/icons.ts
import { iconSvg, type IconName } from '../scripts/icons';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
---
<Fragment set:html={iconSvg(name, size, className)} />
