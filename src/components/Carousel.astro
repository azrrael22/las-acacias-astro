---
const slides = [
  { src: '/Imagenes/Carrucel1/SaveClip.App_631510219_17995168664913991_1783507250797316903_n.jpg', alt: 'Finca Las Acacias' },
  { src: '/Imagenes/Carrucel1/SaveClip.App_520444564_18331429156204659_8892358395334936031_n.jpg', alt: 'Finca Las Acacias' },
  { src: '/Imagenes/Carrucel1/SaveClip.App_633812969_18359922040204659_551851676688721248_n.jpg',  alt: 'Finca Las Acacias' },
  { src: '/Imagenes/Carrucel1/SaveClip.App_623810501_18356551516204659_8429022772883105409_n.jpg', alt: 'Finca Las Acacias' },
  { src: '/Imagenes/Carrucel1/SaveClip.App_634829245_18359922022204659_6284918595975537638_n.jpg', alt: 'Finca Las Acacias' },
  { src: '/Imagenes/Carrucel1/SaveClip.App_633796539_18359922067204659_521136257556392024_n.jpg',  alt: 'Finca Las Acacias' },
];
---
<section class="carousel-seccion section-inner" id="cafe">
  <div class="carousel-viewport">
    <div class="carousel-track" id="carouselTrack">
      {slides.map(slide => (
        <div class="cafe-card">
          <img src={slide.src} alt={slide.alt} />
        </div>
      ))}
      {/* clones para loop circular seamless */}
      {slides.map(slide => (
        <div class="cafe-card" aria-hidden="true">
          <img src={slide.src} alt={slide.alt} />
        </div>
      ))}
    </div>
  </div>
  <div class="carousel-controls" id="carouselDots">
    {slides.map((_, i) => (
      <button
        class:list={['carousel-dot', { active: i === 0 }]}
        data-index={i}
        aria-label={`Foto ${i + 1}`}
      />
    ))}
  </div>
</section>

<script>
  const track   = document.getElementById('carouselTrack');
  const section = document.querySelector('.carousel-seccion');
  const dots    = document.querySelectorAll('.carousel-dot');

  if (track && dots.length) {
    const cardW       = 280;
    const gap         = 12;
    const AUTOPLAY_MS = 3000;
    const REAL        = dots.length; // 6 slides reales
    let current  = 0;
    let startX   = 0;
    let dragging = false;
    let paused   = false;

    function goTo(index: number, instant = false) {
      current = index;
      const el = track as HTMLElement;
      if (instant) {
        el.style.transition = 'none';
        el.style.transform  = `translateX(-${current * (cardW + gap)}px)`;
        el.offsetWidth; // fuerza reflow antes de restaurar la transición
        el.style.transition = '';
      } else {
        el.style.transform = `translateX(-${current * (cardW + gap)}px)`;
      }
      dots.forEach((d, i) => d.classList.toggle('active', i === current % REAL));
    }

    // Después de cada transición CSS: si estamos en zona de clones, snap invisible al real equivalente
    (track as HTMLElement).addEventListener('transitionend', () => {
      if (current >= REAL) goTo(current - REAL, true);
      if (current < 0)    goTo(current + REAL, true);
    });

    let timer = setInterval(() => { if (!paused) goTo(current + 1); }, AUTOPLAY_MS);

    function resetAutoplay() {
      clearInterval(timer);
      timer = setInterval(() => { if (!paused) goTo(current + 1); }, AUTOPLAY_MS);
    }

    section?.addEventListener('mouseenter', () => { paused = true; });
    section?.addEventListener('mouseleave', () => { paused = false; });

    dots.forEach(dot =>
      dot.addEventListener('click', () => {
        goTo(parseInt((dot as HTMLElement).dataset.index ?? '0', 10));
        resetAutoplay();
      })
    );

    track.addEventListener('mousedown', e => { startX = (e as MouseEvent).clientX; dragging = true; });
    document.addEventListener('mouseup', e => {
      if (!dragging) return;
      dragging = false;
      const diff = startX - (e as MouseEvent).clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          goTo(current + 1);
        } else {
          // arrastre hacia atrás: si estamos en la primera, snap instantáneo a la última real
          goTo(current === 0 ? REAL - 1 : current - 1, current === 0);
        }
        resetAutoplay();
      }
    });

    track.addEventListener('touchstart', e => { startX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', e => {
      const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          goTo(current + 1);
        } else {
          goTo(current === 0 ? REAL - 1 : current - 1, current === 0);
        }
        resetAutoplay();
      }
    }, { passive: true });
  }
</script>
