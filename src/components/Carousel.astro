---
const slides = [
  { src: '/Imagenes/Carrucel1/1.webp', alt: 'Visitante recolectando café con un canasto entre los cafetos' },
  { src: '/Imagenes/Carrucel1/2.webp', alt: 'Perro de la finca mirando los cafetales en ladera bajo la niebla' },
  { src: '/Imagenes/Carrucel1/3.webp', alt: 'Grupo de visitantes en la barra durante el tour de café' },
  { src: '/Imagenes/Carrucel1/4.webp', alt: 'Taza de café frente a las montañas de Salento' },
  { src: '/Imagenes/Carrucel1/5.webp', alt: 'Mano recogiendo una cereza madura de café' },
  { src: '/Imagenes/Carrucel1/6.webp', alt: 'Letrero tallado de Finca Las Acacias y una orquídea colgante en la casa' },
];
---
<section class="carousel-seccion section-inner" id="cafe" aria-label="Galería de imágenes de la finca">
  <div class="carousel-viewport">
    <div class="carousel-track" id="carouselTrack">
      {slides.map(slide => (
        <div class="cafe-card">
          <img src={slide.src} alt={slide.alt} width="1080" height="1440" loading="lazy" decoding="async" />
        </div>
      ))}
      {/* clones para loop circular seamless — ocultos a lectores de pantalla */}
      {slides.map(slide => (
        <div class="cafe-card" aria-hidden="true">
          <img src={slide.src} alt="" width="1080" height="1440" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
  <div class="carousel-controls" id="carouselDots" role="group" aria-label="Controles del carrusel">
    {slides.map((_, i) => (
      <button
        type="button"
        class:list={['carousel-dot', { active: i === 0 }]}
        data-index={i}
        aria-label={`Foto ${i + 1}`}
      />
    ))}
  </div>
</section>

<style>
  .carousel-track {
    cursor: grab;
  }
  .carousel-track.dragging {
    cursor: grabbing;
    user-select: none;
  }
  .carousel-track.dragging img {
    pointer-events: none;
    -webkit-user-drag: none;
  }
</style>

<script>
  const track   = document.getElementById('carouselTrack');
  const section = document.querySelector('.carousel-seccion');
  const dots    = document.querySelectorAll('.carousel-dot');

  if (track && dots.length) {
    const cardW       = 280;
    const gap         = 12;
    const AUTOPLAY_MS = 2000;
    // Sin autoplay para quien pide movimiento reducido
    const autoplay    = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const REAL        = dots.length; // 6 slides reales
    let current  = 0;
    let startX   = 0;
    let dragging = false;
    let paused   = false;
    let currentDragOffset = 0;

    function goTo(index: number, instant = false) {
      current = index;
      const el = track as HTMLElement;
      if (instant) {
        el.style.transition = 'none';
        el.style.transform  = `translateX(-${current * (cardW + gap)}px)`;
        el.offsetWidth; // fuerza reflow antes de restaurar la transición
        el.style.transition = '';
      } else {
        el.style.transform = `translateX(-${current * (cardW + gap)}px)`;
      }
      dots.forEach((d, i) => d.classList.toggle('active', i === current % REAL));
    }

    // Después de cada transición CSS: si estamos en zona de clones, snap invisible al real equivalente
    (track as HTMLElement).addEventListener('transitionend', () => {
      if (current >= REAL) goTo(current - REAL, true);
      if (current < 0)    goTo(current + REAL, true);
    });

    const startAutoplay = () => autoplay ? setInterval(() => { if (!paused) goTo(current + 1); }, AUTOPLAY_MS) : undefined;
    let timer = startAutoplay();

    function resetAutoplay() {
      clearInterval(timer);
      timer = startAutoplay();
    }

    section?.addEventListener('mouseenter', () => { paused = true; });
    section?.addEventListener('mouseleave', () => { paused = false; });

    dots.forEach(dot =>
      dot.addEventListener('click', () => {
        goTo(parseInt((dot as HTMLElement).dataset.index ?? '0', 10));
        resetAutoplay();
      })
    );

    track.addEventListener('mousedown', e => {
      startX = (e as MouseEvent).clientX;
      dragging = true;
      currentDragOffset = 0;
      (track as HTMLElement).style.transition = 'none';
      (track as HTMLElement).classList.add('dragging');
      e.preventDefault();
    });

    document.addEventListener('mousemove', e => {
      if (!dragging) return;
      const diff = startX - (e as MouseEvent).clientX;
      currentDragOffset = diff;
      const baseX = current * (cardW + gap);
      (track as HTMLElement).style.transform = `translateX(-${baseX + diff}px)`;
    });

    document.addEventListener('mouseup', () => {
      if (!dragging) return;
      dragging = false;
      (track as HTMLElement).classList.remove('dragging');
      (track as HTMLElement).style.transition = '';

      if (Math.abs(currentDragOffset) > 50) {
        if (currentDragOffset > 0) {
          goTo(current + 1);
        } else {
          goTo(current === 0 ? REAL - 1 : current - 1, current === 0);
        }
        resetAutoplay();
      } else {
        (track as HTMLElement).style.transform = `translateX(-${current * (cardW + gap)}px)`;
      }
      currentDragOffset = 0;
    });

    track.addEventListener('touchstart', e => { startX = (e as TouchEvent).touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', e => {
      const diff = startX - (e as TouchEvent).changedTouches[0].clientX;
      if (Math.abs(diff) > 50) {
        if (diff > 0) {
          goTo(current + 1);
        } else {
          goTo(current === 0 ? REAL - 1 : current - 1, current === 0);
        }
        resetAutoplay();
      }
    }, { passive: true });
  }
</script>
