---
// Botón flotante del carrito (estilos en organisms.css)
import Icon from './Icon.astro';
---

<button
  id="floating-cart-btn"
  class="floating-cart-btn"
  type="button"
  aria-label="Abrir carrito de compras"
>
  <Icon name="shopping-bag" size={24} />
  <span id="cart-badge" class="cart-badge" aria-hidden="true">0</span>
</button>

<script>
  import { getCartCount, CART_UPDATED_EVENT } from '../scripts/cart';

  const cartButton = document.getElementById('floating-cart-btn');
  const cartBadge = document.getElementById('cart-badge');

  if (cartButton && cartBadge) {
    const updateCartBadge = () => {
      const count = getCartCount();
      cartBadge.textContent = String(count);
      cartBadge.classList.toggle('visible', count > 0);
      cartButton.setAttribute(
        'aria-label',
        count > 0
          ? `Abrir carrito de compras (${count} ${count === 1 ? 'producto' : 'productos'})`
          : 'Abrir carrito de compras'
      );
    };

    updateCartBadge();
    window.addEventListener(CART_UPDATED_EVENT, updateCartBadge);

    // CartModal escucha este evento
    cartButton.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('cart:open'));
    });
  }
</script>
