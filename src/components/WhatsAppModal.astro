---
// Modal de confirmación de WhatsApp
---

<div id="whatsapp-modal" class="whatsapp-modal" role="dialog" aria-labelledby="whatsapp-modal-title" aria-hidden="true">
  <div class="whatsapp-overlay"></div>
  <div class="whatsapp-content">
    <div class="whatsapp-header">
      <h2 id="whatsapp-modal-title" class="whatsapp-title">📱 Enviar por WhatsApp</h2>
      <button id="whatsapp-close-btn" class="whatsapp-close-btn" type="button" aria-label="Cerrar">
        ✕
      </button>
    </div>

    <div class="whatsapp-body">
      <p class="whatsapp-instructions">
        Puedes editar el mensaje antes de enviarlo si lo deseas:
      </p>
      
      <textarea 
        id="whatsapp-message" 
        class="whatsapp-textarea"
        rows="12"
        aria-label="Mensaje de WhatsApp"
      ></textarea>

      <div class="whatsapp-actions">
        <button id="whatsapp-send-btn" class="whatsapp-btn whatsapp-btn-primary" type="button">
          <span class="btn-icon">📱</span>
          <span>Abrir WhatsApp</span>
        </button>
        
        <button id="whatsapp-copy-btn" class="whatsapp-btn whatsapp-btn-secondary" type="button">
          <span class="btn-icon">📋</span>
          <span id="copy-btn-text">Copiar mensaje</span>
        </button>
      </div>

      <button id="whatsapp-cancel-btn" class="whatsapp-btn-link" type="button">
        Cancelar
      </button>
    </div>
  </div>
</div>

<script>
  import { 
    generateWhatsAppMessage, 
    getWhatsAppURL,
    copyMessageToClipboard,
    clearCart 
  } from '../scripts/cart';

  // ============================================
  // ELEMENTOS DEL DOM
  // ============================================

  const modal = document.getElementById('whatsapp-modal');
  const overlay = modal?.querySelector('.whatsapp-overlay');
  const closeBtn = document.getElementById('whatsapp-close-btn');
  const cancelBtn = document.getElementById('whatsapp-cancel-btn');
  const sendBtn = document.getElementById('whatsapp-send-btn');
  const copyBtn = document.getElementById('whatsapp-copy-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  const messageTextarea = document.getElementById('whatsapp-message') as HTMLTextAreaElement;

  let currentCustomerName = '';

  // ============================================
  // FUNCIONES DE UI
  // ============================================

  function openModal(customerName: string) {
    if (!modal || !messageTextarea) return;

    currentCustomerName = customerName;
    const message = generateWhatsAppMessage(customerName);
    
    messageTextarea.value = message;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeModal() {
    if (!modal) return;
    
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    
    // Reset copy button
    if (copyBtnText) {
      copyBtnText.textContent = 'Copiar mensaje';
    }
  }

  // ============================================
  // EVENT LISTENERS
  // ============================================

  // Escuchar evento de checkout desde CartModal
  window.addEventListener('cart:checkout', ((e: CustomEvent) => {
    const { customerName } = e.detail;
    
    // Cerrar CartModal primero
    window.dispatchEvent(new CustomEvent('cart:close'));
    
    // Abrir WhatsAppModal después de un pequeño delay
    setTimeout(() => {
      openModal(customerName);
    }, 300);
  }) as EventListener);

  // Cerrar modal
  closeBtn?.addEventListener('click', closeModal);
  cancelBtn?.addEventListener('click', closeModal);
  overlay?.addEventListener('click', closeModal);

  // Cerrar con ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) {
      closeModal();
    }
  });

  // Abrir WhatsApp
  sendBtn?.addEventListener('click', () => {
    // Obtener mensaje editado del textarea
    const message = messageTextarea?.value || '';
    
    if (message.trim()) {
      // Construir URL manualmente con el mensaje del textarea
      const encodedMessage = encodeURIComponent(message);
      const url = `https://wa.me/573175336091?text=${encodedMessage}`;
      
      // Abrir WhatsApp
      window.open(url, '_blank');
      
      // Preguntar si desea vaciar el carrito
      setTimeout(() => {
        if (confirm('¿Deseas vaciar el carrito?')) {
          clearCart();
        }
        closeModal();
      }, 500);
    }
  });

  // Copiar mensaje
  copyBtn?.addEventListener('click', async () => {
    const message = messageTextarea?.value || '';
    
    if (!message.trim()) return;

    try {
      await navigator.clipboard.writeText(message);
      
      // Feedback visual
      if (copyBtnText) {
        const originalText = copyBtnText.textContent;
        copyBtnText.textContent = '✓ Copiado';
        copyBtn?.classList.add('copied');
        
        setTimeout(() => {
          copyBtnText.textContent = originalText;
          copyBtn?.classList.remove('copied');
        }, 2000);
      }
    } catch (error) {
      console.error('Error al copiar:', error);
      alert('No se pudo copiar el mensaje. Por favor, cópialo manualmente.');
    }
  });

  // Event listener para cerrar desde CartModal
  window.addEventListener('cart:close', () => {
    const cartModal = document.getElementById('cart-modal');
    if (cartModal) {
      cartModal.classList.remove('open');
      cartModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  });
</script>
